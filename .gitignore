# Rust build artifacts
/target/
debug

# rustfmt backup files
**/*.rs.bk

# MSVC Windows builds
*.pdb

# Coverage / profiling / mutation testing output
*.profraw
*.profdata
gcov/
**/mutants.out*/

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Secrets — never commit real credentials.
# Note: intentional examples such as `.env.example` are NOT ignored.
.env
.env.*
!.env.example

# Python caches from the optional developer precheck script
__pycache__/
*.pyc

# Hamstik Wheel config
.hamstik-wheel.toml
